<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF0F62FE" android:endColor="#FF7B2CFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF1565FF" android:centerColor="#FF4F46E5" android:endColor="#FF8B5CF6" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
